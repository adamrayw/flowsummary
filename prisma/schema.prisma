generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Summary {
  id              String   @id @default(cuid())
  userId          String
  userEmail       String?
  title           String
  template        String?
  sourceText      String
  instructions    String
  summary         String
  keyInsights     Json
  recommendations Json
  conclusion      String
  model           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, updatedAt])
}

model Document {
  id                String   @id @default(cuid())
  userId            String
  filename          String
  fileType          String
  sourceText        String?
  classification    String?
  confidence        Float?
  extractionContext Json?
  analysisContext   Json?
  recommendations   Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  reports           GeneratedReport[]

  @@index([userId, createdAt])
}

model GeneratedReport {
  id              String   @id @default(cuid())
  documentId      String
  userId          String
  title           String
  reportType      String
  content         Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([userId, documentId])
}
